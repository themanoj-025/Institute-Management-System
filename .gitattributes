# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Python source
*.py text diff=python

# HTML templates
*.html text diff=html

# CSS stylesheets
*.css text

# JavaScript
*.js text
*.ts text
*.jsx text diff=javascript
*.tsx text diff=javascript

# Markdown documentation
*.md text eol=lf
*.rst text

# Config / locale files
*.yml text
*.yaml text
*.toml text
*.json text
*.cfg text
*.ini text

# Security: prevent secret files from appearing in diffs if accidentally created
*.env -diff
*.env.* -diff
*.pem -diff
*.key -diff
*.cert -diff
*.crt -diff
*.p12 -diff
*.pfx -diff
*.pkcs12 -diff
*.kdbx -diff
*id_rsa* -diff
*id_ed25519* -diff
*credentials*.json -diff
*client_secret*.json -diff
*service-account*.json -diff
*token*.json -diff

# Shell / batch scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Docker
Dockerfile text
Dockerfile.* text
docker-compose.yml text
.dockerignore text

# Requirements / project config
requirements.txt text
requirements*.txt text
pyproject.toml text
LICENSE text

# Web dashboard
package.json text
vite.config.js text

# Binary / export files - don't modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.xls binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.zip binary
*.tar.gz binary
*.pkl binary
*.joblib binary
*.model binary

# nginx config
nginx/*.conf text

# Archive export ignores: exclude development, CI, and test tooling from release archives
.github/ export-ignore
.gitleaks.toml export-ignore
.pre-commit-config.yaml export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.git-blame-ignore-revs export-ignore
.gitmessage export-ignore
tests/ export-ignore
