[TEMPLATE]
# Database — PostgreSQL (production) or SQLite (local/offline desktop mode)
DATABASE_URL=postgresql://bbims:your_db_password@host:5432/bb_ims
# For SQLite fallback: sqlite:///database/bb_ims.db
DB_PATH=database/bb_ims.db

# PostgreSQL credentials (used by docker-compose.yml to create the DB)
POSTGRES_USER=bbims
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=bb_ims

# Redis (token blacklist, Celery broker, cache)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security — REQUIRED: app will NOT start without this
SECRET_KEY=change_me_in_production_use_secrets_token_hex_32

# Email (optional — leave blank to disable email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Environment (development shows OTP in console; production hides it)
ENV=development

# Upgrades
BCRYPT_COST=14
API_PORT=8000
JWT_EXPIRE_HOURS=24
