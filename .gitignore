# ==============================================================================
# Institute-Management-System - Security & Production .gitignore
# ==============================================================================

# [GITIGNORE SECTION 1] Python runtime artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# [GITIGNORE SECTION 2] Virtual environments
venv/
env/
ENV/
.venv/
.venv*/
.env_folder/
Pipfile.lock
poetry.lock
env.bak/
venv.bak/

# [GITIGNORE SECTION 3] Environment & secrets (CRITICAL)
.env
.env.*
*.env
.env.local
.env.*.local
.env.development
.env.test
.env.staging
.env.production
!.env.example
!.env.template
!.env.sample

# Private keys, certificates & credentials
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.pkcs12
*.cer
*.crt
*.der
*.id_rsa
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
nginx/ssl/

# Cloud & service credentials
secrets.json
credentials.json
*credentials*.json
client_secret*.json
client_secrets*.json
service-account*.json
service_account*.json
serviceAccountKey*.json
google-services.json
google-credentials*.json
GoogleService-Info.plist
.aws/
.azure/
.gcp/
gcloud/
.act-secrets
*.secrets.*
.secrets
*.publishsettings
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
kubeconfig
*.kubeconfig
.kube/

# Password vaults & cryptographic stores
*.kdbx

# Authentication tokens & configs
.netrc
.pypirc
.npmrc
*token*.json
token.pickle
auth*.json

# [GITIGNORE SECTION 4] Database files
database/*.db
database/*.db-shm
database/*.db-wal
database/*.bak
database/*.sqlite
database/*.sqlite3
# Database JSON data files contain seed/personal data — not committed
# Locale JSON files (locales/*.json) remain tracked
database/*.json
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sql.gz
*.rdb

# [GITIGNORE SECTION 5] Logs
logs/
*.log
log/
*.log.*
*.dump
*.stackdump

# [GITIGNORE SECTION 6] User-generated assets (runtime)
assets/profiles/*.jpg
assets/profiles/*.jpeg
assets/profiles/*.png
database/uploads/
exports/generated/

# [GITIGNORE SECTION 7] OS artifacts
# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*
*.tmp
*.temp
*.bak

# [GITIGNORE SECTION 8] IDE & editor artifacts
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.local.*
.vscode/mcp.json
*.code-workspace

# PyCharm / JetBrains
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace

# Vim / Neovim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# [GITIGNORE SECTION 9] Testing & coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
htmlcov/
.hypothesis/
nosetests.xml
test-results/
coverage.json
radar_balance.txt
.ruff_cache/
.mypy_cache/

# [GITIGNORE SECTION 10] Alembic runtime
alembic/versions/*.pyc

# [GITIGNORE SECTION 11] ML model artifacts (runtime-generated)
ml/models/*.json
!ml/models/reference_distributions.json
!ml/models/risk_v1_meta.json
ml/models/*_eval.md
ml/models/*_eval.json
ml/models/*.model

# [GITIGNORE SECTION 12] Backup & export files
*.zip
*.tar.gz
*.bak
*.backup
backups/

# [GITIGNORE SECTION 13] Web dashboard & Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
web/node_modules/
web/dist/
web/.vite/
web/coverage/

# [GITIGNORE SECTION 14] Jupyter (if used for analytics dev)
.ipynb_checkpoints/
*.ipynb

!.gitmessage
!CITATION.cff
