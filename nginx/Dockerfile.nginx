# ── Nginx with web dashboard (CI/CD build) ─────────────────────────
#
# Build context must be the repository root (.):
#
#   docker build -t bbims-nginx -f nginx/Dockerfile.nginx .
#
# The web dashboard source is at ./web/ and the nginx config at ./nginx/.
# The image packages the built React SPA with nginx for production.
# TLS certificates must be mounted at runtime at /etc/nginx/ssl/.
# ───────────────────────────────────────────────────────────────────

# ── Stage 1: Build the web dashboard ────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app
COPY web/package.json web/package-lock.json* ./
RUN npm ci

COPY web/ .
RUN npm run build

# ── Stage 2: Nginx production image ─────────────────────────────────
FROM nginx:alpine

# Remove default nginx config
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copy our nginx config
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Copy the built web dashboard
COPY --from=builder /app/dist /usr/share/nginx/html

# Create ssl directory (certs must be mounted at runtime)
RUN mkdir -p /etc/nginx/ssl

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
